rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // AUTH / ADMIN
    // =====================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == "CDwCqUitlaSHEVeWQufCb0lXzMx1";
    }

    // =====================================================
    // COURSES
    // =====================================================

    match /courses/{courseId} {
      // Legacy behavior preserved: published courses are publicly readable;
      // admin can read all courses and is the only writer.
      allow read: if isAdmin()
                  || (resource.data.published == true);

      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =====================================================
    // LESSON PROGRESS / ATTENDANCE
    // =====================================================

    match /lessonProgress/{progressId} {
      // Students can only read their own progress.
      allow read: if isAdmin()
                  || (isSignedIn()
                      && resource.data.userId == request.auth.uid);

      // Students may create progress only for themselves.
      allow create: if isAdmin()
                    || (isSignedIn()
                        && request.resource.data.userId == request.auth.uid);

      // Students may update only their own progress and cannot transfer
      // ownership to another account.
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.userId == request.auth.uid);

      allow delete: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid);
    }

    // =====================================================
    // CERTIFICATES
    // =====================================================

    match /certificates/{certificateId} {
      // Public exact-ID verification only; listing remains disabled.
      allow get: if true;
      allow list: if false;

      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =====================================================
    // USERS
    // =====================================================

    match /users/{userId} {
      // Admin can manage all users; normal users can manage only themselves.
      allow read, create, update, delete: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId);
    }

    // =====================================================
    // DEFAULT SECURITY — LEGACY LOGIC PRESERVED
    // =====================================================

    // Authenticated users -> READ
    // Anonymous users      -> NO READ
    // Admin                -> WRITE
    //
    // This keeps the previous default behavior while the explicit
    // lessonProgress and users matches provide tighter ownership controls.
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
