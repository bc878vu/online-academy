rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // AUTH / ADMIN
    // =====================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == "CDwCqUitlaSHEVeWQufCb0lXzMx1";
    }

    // =====================================================
    // COURSES
    // =====================================================

    match /courses/{courseId} {
      // Legacy behavior: published courses are publicly readable;
      // admin can read all courses and is the only writer.
      allow read: if isAdmin()
                  || (resource.data.published == true);

      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =====================================================
    // LESSON PROGRESS / ATTENDANCE
    // =====================================================

    match /lessonProgress/{progressId} {
      allow read: if isAdmin()
                  || (isSignedIn()
                      && resource.data.userId == request.auth.uid);

      allow create: if isAdmin()
                    || (isSignedIn()
                        && request.resource.data.userId == request.auth.uid);

      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.userId == request.auth.uid);

      allow delete: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid);
    }

    // =====================================================
    // CERTIFICATES
    // =====================================================

    match /certificates/{certificateId} {
      // Public exact-ID verification; listing remains disabled.
      allow get: if true;
      allow list: if false;

      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =====================================================
    // USERS
    // =====================================================

    match /users/{userId} {
      allow read, create, update, delete: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId);
    }

    // =====================================================
    // DEFAULT SECURITY — LEGACY LOGIC PRESERVED
    // =====================================================

    // For every other collection, preserve the old behavior:
    // Authenticated users -> READ
    // Anonymous users      -> NO READ
    // Admin                -> WRITE
    //
    // lessonProgress and users are explicitly excluded here so that the
    // ownership rules above can actually restrict access. Firestore rules
    // are OR-based: a broad matching allow cannot be overridden by a more
    // restrictive specific match.
    match /{document=**} {
      allow read: if isSignedIn()
                  && !document.matches(/^lessonProgress\/.*$/)
                  && !document.matches(/^users\/.*$/);
      allow write: if isAdmin();
    }
  }
}
