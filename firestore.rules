rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.uid == "CDwCqUitlaSHEVeWQufCb0lXzMx1"; }
    function isOwner(data) { return isSignedIn() && data.userId == request.auth.uid; }
    function validPublicMessage() {
      return request.resource.data.keys().hasAll(["userId", "name", "email", "message", "status", "honeypot", "createdAt"])
        && (request.resource.data.userId == null || (isSignedIn() && request.resource.data.userId == request.auth.uid))
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 160
        && request.resource.data.message is string && request.resource.data.message.size() >= 8 && request.resource.data.message.size() <= 2000
        && request.resource.data.status == "new" && request.resource.data.honeypot == "" && request.resource.data.createdAt == request.time;
    }

    match /courses/{courseId} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }
    match /assessmentKeys/{courseId} {
      allow read, write: if isAdmin();
    }
    match /lessonProgress/{progressId} {
      allow get, list: if isAdmin() || isOwner(resource.data);
      allow create: if isAdmin() || (isSignedIn() && progressId.matches('^' + request.auth.uid + '_.*$') && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && progressId.matches('^' + request.auth.uid + '_.*$') && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /assessmentAttempts/{attemptId} {
      allow get, list: if isAdmin() || isOwner(resource.data);
      allow create, update, delete: if isAdmin();
    }
    match /courseCompletions/{completionId} {
      allow get, list: if isAdmin() || isOwner(resource.data);
      allow create, update, delete: if isAdmin();
    }
    match /certificateRequests/{requestId} {
      allow get, list: if isAdmin() || isOwner(resource.data);
      allow create: if isSignedIn()
        && requestId == request.auth.uid + "_" + request.resource.data.courseId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && exists(/databases/$(database)/documents/courseCompletions/$(request.auth.uid + "_" + request.resource.data.courseId));
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid && resource.data.status == "rejected");
    }
    match /certificates/{certificateId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }
    match /users/{userId} {
      allow read, create, update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }
    match /orders/{orderId} {
      allow get, list: if isAdmin() || isOwner(resource.data);
      allow create, update, delete: if isAdmin();
    }
    match /coupons/{couponId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /siteOffers/{offerId} {
      allow get, list: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }
    match /reviews/{reviewId} {
      allow get, list: if isAdmin() || resource.data.status == "published" || isOwner(resource.data);
      allow create: if isSignedIn()
        && reviewId == request.auth.uid + "_" + request.resource.data.courseId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.courseId is string && request.resource.data.courseId.size() > 0
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.published == true
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.review is string && request.resource.data.review.size() >= 8 && request.resource.data.review.size() <= 1200
        && request.resource.data.status == "published" && request.resource.data.verified == false && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId && request.resource.data.courseId == resource.data.courseId && request.resource.data.courseTitle == resource.data.courseTitle && request.resource.data.status == resource.data.status
        && request.resource.data.verified == resource.data.verified && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.review is string && request.resource.data.review.size() >= 8 && request.resource.data.review.size() <= 1200);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /contactMessages/{messageId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if validPublicMessage();
      allow update, delete: if isAdmin();
    }
    match /feedback/{feedbackId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if validPublicMessage();
      allow update, delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
