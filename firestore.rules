rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // AUTH / ADMIN
    // =====================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == "CDwCqUitlaSHEVeWQufCb0lXzMx1";
    }

    // =====================================================
    // COURSES
    // =====================================================

    match /courses/{courseId} {
      allow read: if isAdmin()
                  || (resource.data.published == true);

      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =====================================================
    // LESSON PROGRESS / ATTENDANCE
    // =====================================================

    match /lessonProgress/{progressId} {
      // Students can only read their own progress.
      allow read: if isAdmin()
                  || (isSignedIn()
                      && resource.data.userId == request.auth.uid);

      // Students may create progress only for themselves.
      allow create: if isAdmin()
                    || (isSignedIn()
                        && request.resource.data.userId == request.auth.uid);

      // Students may update only their own progress and cannot transfer
      // ownership to another account.
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.userId == request.auth.uid);

      allow delete: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid);
    }

    // =====================================================
    // CERTIFICATES
    // =====================================================

    match /certificates/{certificateId} {
      allow get: if true;
      allow list: if false;

      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =====================================================
    // USERS
    // =====================================================

    match /users/{userId} {
      allow read, create, update, delete: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId);
    }

    // =====================================================
    // DEFAULT SECURITY
    // =====================================================

    // Authenticated users may read unspecified application collections.
    // Anonymous users have no access. Only admin may write unspecified data.
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
