rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.uid == "CDwCqUitlaSHEVeWQufCb0lXzMx1"; }
    function isOwner(data) { return isSignedIn() && data.userId == request.auth.uid; }

    match /courses/{courseId} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    match /lessonProgress/{progressId} {
      allow get, list: if isAdmin() || isOwner(resource.data);
      allow create: if isAdmin() || (isSignedIn() && progressId.matches('^' + request.auth.uid + '_.*$') && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && progressId.matches('^' + request.auth.uid + '_.*$') && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /assessmentAttempts/{attemptId} {
      allow get, list: if isAdmin() || isOwner(resource.data);
      allow create: if isAdmin() || (isSignedIn() && attemptId.matches('^' + request.auth.uid + '_.*$') && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && attemptId.matches('^' + request.auth.uid + '_.*$') && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /courseCompletions/{completionId} {
      allow get, list: if isAdmin() || isOwner(resource.data);
      allow create: if isAdmin() || (isSignedIn() && completionId == request.auth.uid + "_" + request.resource.data.courseId && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && completionId == request.auth.uid + "_" + resource.data.courseId && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && request.resource.data.courseId == resource.data.courseId);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /certificateRequests/{requestId} {
      allow get, list: if isAdmin() || isOwner(resource.data);
      allow create: if isAdmin() || (isSignedIn() && requestId == request.auth.uid + "_" + request.resource.data.courseId && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && requestId == request.auth.uid + "_" + resource.data.courseId && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && request.resource.data.courseId == resource.data.courseId);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /certificates/{certificateId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin() || isOwner(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
