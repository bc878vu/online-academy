rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == "CDwCqUitlaSHEVeWQufCb0lXzMx1";
    }

    match /courses/{courseId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // A student may only read/write the progress document whose ID is built
    // from that student's UID. This also makes setDoc(..., {merge:true}) work
    // consistently for both first-time creates and subsequent updates.
    match /lessonProgress/{progressId} {
      allow read: if isAdmin()
                  || (isSignedIn()
                      && progressId.matches('^' + request.auth.uid + '_.*$'));

      allow create: if isAdmin()
                    || (isSignedIn()
                        && progressId.matches('^' + request.auth.uid + '_.*$')
                        && request.resource.data.userId == request.auth.uid);

      allow update: if isAdmin()
                    || (isSignedIn()
                        && progressId.matches('^' + request.auth.uid + '_.*$')
                        && request.resource.data.userId == request.auth.uid);

      allow delete: if isAdmin()
                    || (isSignedIn()
                        && progressId.matches('^' + request.auth.uid + '_.*$'));
    }

    match /certificates/{certificateId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update, delete: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId);
    }

    match /{document=**} {
      allow read: if isSignedIn()
                  && !document.matches(/^lessonProgress\/.*$/)
                  && !document.matches(/^users\/.*$/);
      allow write: if isAdmin();
    }
  }
}
